rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny: All unmatched collections are inaccessible from client SDKs
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Collection
    // Owners may read their profile. Writes go through the backend so a client
    // cannot alter identity or server-maintained billing/group fields.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 2. Sessions Collection (Real-time active split rooms)
    // Managed exclusively through backend API server (Admin SDK) to enforce room tokens & member verification
    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    // 3. Groups Collection (Shared group expense rooms)
    // Managed exclusively through backend API server (Admin SDK) to enforce member authentication
    match /groups/{groupId} {
      allow read, write: if false;
    }

    // 4. History Collection (Settled bills archive)
    // Managed exclusively through backend API server (Admin SDK) to isolate user payment records
    match /history/{historyId} {
      allow read, write: if false;
    }
  }
}
